{
  "contextName": "Confort",
  "analysisName": "Point température par pièce",
  "description": "Anchor: a floor (or any node holding rooms). No resolver: the anchor is the only work node. Every night, gives each room that has a temperature endpoint a node « Température ambiante » sharing the endpoint's current value (the same value, not a copy — it then follows the sensor without any run) and its unit as an attribute. Pattern: writing to the graph in a way that is safe to re-run (CREATE_NODE reuses, SHARE_VALUE changes nothing the second time), chaining blocks on the node they return.",
  "status": "Inactive",
  "triggers": [
    {
      "id": "EveryNight",
      "type": "CRON",
      "cronExpression": "0 3 * * *"
    }
  ],
  "executionWorkflow": {
    "blocks": [
      {
        "ref": "Rooms",
        "algorithmName": "GET_NODE_CHILDREN",
        "inputs": [
          "$node"
        ],
        "parameters": {
          "regex": "^hasGeographicRoom$"
        }
      },
      {
        "ref": "Rooms with a sensor",
        "algorithmName": "FILTER",
        "inputs": [
          "Rooms"
        ],
        "itemRef": "candidate",
        "subWorkflow": {
          "outputRef": "Has a sensor",
          "blocks": [
            {
              "ref": "Maybe a sensor",
              "algorithmName": "GET_NODE_CHILD",
              "inputs": [
                "candidate"
              ],
              "parameters": {
                "regex": "^hasBmsEndpoint$",
                "regexFilter": "Temp",
                "ifNotFound": "null"
              }
            },
            {
              "ref": "Has a sensor",
              "algorithmName": "EXISTS",
              "inputs": [
                "Maybe a sensor"
              ]
            }
          ]
        }
      },
      {
        "ref": "Each room",
        "algorithmName": "FOREACH",
        "inputs": [
          "Rooms with a sensor"
        ],
        "itemRef": "room",
        "subWorkflow": {
          "outputRef": "With unit",
          "blocks": [
            {
              "ref": "Sensor",
              "algorithmName": "GET_NODE_CHILD",
              "inputs": [
                "room"
              ],
              "parameters": {
                "regex": "^hasBmsEndpoint$",
                "regexFilter": "Temp"
              }
            },
            {
              "ref": "Point",
              "algorithmName": "CREATE_NODE",
              "inputs": [
                "room"
              ],
              "parameters": {
                "name": "Température ambiante",
                "type": "roomPoint",
                "relationName": "hasRoomPoint"
              }
            },
            {
              "ref": "With value",
              "algorithmName": "SHARE_VALUE",
              "inputs": [
                "Sensor",
                "Point"
              ],
              "parameters": {
                "sourceProperty": "element.currentValue"
              }
            },
            {
              "ref": "With unit",
              "algorithmName": "SHARE_VALUE",
              "inputs": [
                "Sensor",
                "With value"
              ],
              "parameters": {
                "sourceProperty": "element.unit",
                "targetProperty": "attr.Mesure.Unité"
              }
            }
          ]
        }
      }
    ]
  }
}